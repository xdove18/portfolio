# Страницы кейсов существуют только внутри сайта, отдельных файлов
# для них нет. Без этих строк ссылка вида ваш-домен/projects/habits
# при прямом заходе или обновлении страницы выдала бы ошибку 404.
# Правило говорит серверу: если такого файла нет — отдай index.html,
# а сайт сам покажет нужную страницу.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
